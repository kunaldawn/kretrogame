# https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

# C and C++: two spaces, as .clang-format says.
[*.{c,cpp,h}]
indent_size = 2

# Shell: two spaces, as every script here uses.
[*.sh]
indent_size = 2

[*.py]
indent_size = 4

[{Makefile,*.mk}]
indent_style = tab
indent_size = 8

[*.{yml,yaml,toml}]
indent_size = 2

# Markdown ends a line with two spaces to break it.
[*.md]
trim_trailing_whitespace = false

# Upstream code keeps its upstream's whitespace.
[third_party/**]
charset = unset
end_of_line = unset
insert_final_newline = unset
trim_trailing_whitespace = unset
indent_style = unset
indent_size = unset
