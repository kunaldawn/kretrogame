+/* Sets the output to game size times `scale`. The logical size of the
+ * output stays the game's, so the X root still fills it exactly; only the
+ * number of host pixels per game pixel changes. */
+static void
+letterbox_set_scale(struct wayland_output *output, int scale)
+{
+	struct wayland_backend *b = output->backend;
+	int w = b->letterbox.game_w * scale;
+	int h = b->letterbox.game_h * scale;
+
+	if (output->base.current_mode &&
+	    output->base.current_mode->width == w &&
+	    output->base.current_mode->height == h &&
+	    output->base.current_scale == scale) {
+		wayland_output_resize_surface(output);
+		return;
+	}
+
+	output->native_mode.width = w;
+	output->native_mode.height = h;
+	output->native_mode.refresh = output->mode.refresh;
+	if (weston_output_mode_set_native(&output->base, &output->native_mode,
+					  scale) < 0)
+		weston_log("letterbox: cannot set %dx%d at %d\n", w, h, scale);
+}
+
+/* The output's side of going fullscreen, whoever asked for it: Alt+F11
+ * here, or the host's own fullscreen. The scale comes with the configure
+ * that carries the host's size. */
+static void
+letterbox_enter_fullscreen(struct wayland_output *output)
+{
+	output->letterbox_fullscreen = true;
+	if (output->frame) {
+		frame_destroy(output->frame);
+		output->frame = NULL;
+	}
+	wayland_output_resize_surface(output);
+}
+
+/* The output's side of leaving fullscreen, whoever asked for it. */
+static void
+letterbox_leave_fullscreen(struct wayland_output *output)
+{
+	struct wayland_backend *b = output->backend;
+
+	output->letterbox_fullscreen = false;
+	/* Without the theme's images there is no frame; the window is
+	 * still a window, only an undecorated one. */
+	if (!output->frame) {
+		if (!b->theme)
+			b->theme = theme_create();
+		if (b->theme)
+			output->frame = frame_create(b->theme, 100, 100,
+						     FRAME_BUTTON_CLOSE,
+						     output->title, NULL);
+		if (output->frame && output->keyboard_count)
+			frame_set_flag(output->frame, FRAME_FLAG_ACTIVE);
+		output_refresh_capture_title(output);
+	}
+	letterbox_set_scale(output, b->letterbox.window_scale);
+}
+
+static void
+letterbox_set_fullscreen(struct wayland_output *output)
+{
+	letterbox_enter_fullscreen(output);
+	output->letterbox_pending = !output->letterbox_host_fullscreen;
+	xdg_toplevel_set_fullscreen(output->parent.xdg_toplevel, NULL);
+}
+
+static void
+letterbox_set_windowed(struct wayland_output *output)
+{
+	letterbox_leave_fullscreen(output);
+	output->letterbox_pending = output->letterbox_host_fullscreen;
+	xdg_toplevel_unset_fullscreen(output->parent.xdg_toplevel);
+}
