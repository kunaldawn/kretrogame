+/* Passes a close on when somebody asked to hear about it. False when
+ * nobody did, or the reader has gone: then the window closes as upstream,
+ * rather than becoming one that cannot be closed at all. */
+static bool
+close_requested(struct wayland_backend *b)
+{
+	char c = 'c';
+
+	if (b->close_fd < 0)
+		return false;
+	/* A socket, so a reader that has gone is an error here and not a
+	 * SIGPIPE that takes the compositor down with the game in it. */
+	if (send(b->close_fd, &c, 1, MSG_NOSIGNAL | MSG_DONTWAIT) == 1)
+		return true;
+	b->close_fd = -1;
+	return false;
+}
