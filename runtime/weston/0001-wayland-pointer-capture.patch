 /* Events received from the wayland-server this compositor is client of: */
 
+static void
+output_show_capture(struct wayland_output *output, bool captured)
+{
+	char *title = NULL;
+
+	if (!output || !output->title)
+		return;
+
+	if (captured &&
+	    asprintf(&title, "%s - Ctrl+Alt releases the mouse",
+		     output->title) < 0)
+		title = NULL;
+
+	if (output->parent.xdg_toplevel)
+		xdg_toplevel_set_title(output->parent.xdg_toplevel,
+				       title ? title : output->title);
+	if (output->frame) {
+		frame_set_title(output->frame, title ? title : output->title);
+		weston_output_schedule_repaint(&output->base);
+	}
+	free(title);
+}
+
+/* Puts the capture hint back into a title that was just made again: a
+ * frame created on the way back from fullscreen starts from the plain
+ * title. */
+static void
+output_refresh_capture_title(struct wayland_output *output)
+{
+	struct wayland_input *input;
+
+	wl_list_for_each(input, &output->backend->input_list, link) {
+		if (input->output == output && input->capture.locked) {
+			output_show_capture(output, true);
+			return;
+		}
+	}
+}
+
+/* Lets the host pointer go. With `hint`, the host is asked to put its
+ * cursor where the captured pointer got to, so that the pointer does not
+ * jump back to where it was when it was captured. */
+static void
+input_release_capture(struct wayland_input *input, bool hint)
+{
+	struct wayland_output *output = input->output;
+	struct weston_coord c;
+	int32_t fx = 0, fy = 0;
+
+	if (!input->capture.locked_pointer)
+		return;
+
+	if (hint && input->capture.locked && output) {
+		c = weston_matrix_transform_coord(&output->base.matrix,
+						  input->capture.pos.c);
+		if (output->frame)
+			frame_interior(output->frame, &fx, &fy, NULL, NULL);
+		zwp_locked_pointer_v1_set_cursor_position_hint(
+			input->capture.locked_pointer,
+			wl_fixed_from_double(c.x + fx),
+			wl_fixed_from_double(c.y + fy));
+		wl_surface_commit(output->parent.surface);
+	}
+
+	zwp_locked_pointer_v1_destroy(input->capture.locked_pointer);
+	input->capture.locked_pointer = NULL;
+	input->capture.locked = false;
+	input->have_last_pos = false;
+	output_show_capture(output, false);
+}
+
+static void
+locked_pointer_locked(void *data,
+		      struct zwp_locked_pointer_v1 *locked_pointer)
+{
+	struct wayland_input *input = data;
+
+	input->capture.locked = true;
+	output_show_capture(input->output, true);
+}
+
+/* The host ended the lock itself: another window took the focus, or
+ * the lock was refused. A one-shot lock is dead once this arrives, and
+ * the next click in the window captures again. */
+static void
+locked_pointer_unlocked(void *data,
+			struct zwp_locked_pointer_v1 *locked_pointer)
+{
+	struct wayland_input *input = data;
+
+	input_release_capture(input, false);
+}
+
+static const struct zwp_locked_pointer_v1_listener locked_pointer_listener = {
+	locked_pointer_locked,
+	locked_pointer_unlocked,
+};
+
+static bool
+input_try_capture(struct wayland_input *input)
+{
+	struct wayland_backend *b = input->backend;
+	struct wayland_output *output = input->output;
+	struct weston_pointer *pointer = weston_seat_get_pointer(&input->base);
+
+	if (!b->capture_on_click || !b->parent.pointer_constraints ||
+	    !input->capture.relative_pointer ||
+	    input->capture.locked_pointer || !output ||
+	    input->keyboard_focus != output)
+		return false;
+
+	input->capture.locked_pointer =
+		zwp_pointer_constraints_v1_lock_pointer(
+			b->parent.pointer_constraints,
+			output->parent.surface,
+			input->parent.pointer, NULL,
+			ZWP_POINTER_CONSTRAINTS_V1_LIFETIME_ONESHOT);
+	if (!input->capture.locked_pointer)
+		return false;
+	zwp_locked_pointer_v1_add_listener(input->capture.locked_pointer,
+					   &locked_pointer_listener, input);
+	wl_surface_commit(output->parent.surface);
+
+	/* The click's own position, where the host cursor is. */
+	if (input->have_last_pos)
+		input->capture.pos = input->last_pos;
+	else if (pointer)
+		input->capture.pos = pointer->pos;
+	else
+		input->capture.pos = output->base.pos;
+	return true;
+}
+
+/* While the host pointer is locked, this is the only motion there is.
+ * It is in the host surface's pixels, which are the nested output's
+ * device pixels, so it is divided by the output scale; the nested
+ * compositor clamps the result to its outputs, which is what keeps the
+ * pointer inside the game's screen. */
+static void
+relative_pointer_handle_motion(void *data,
+			       struct zwp_relative_pointer_v1 *relative_pointer,
+			       uint32_t utime_hi, uint32_t utime_lo,
+			       wl_fixed_t dx, wl_fixed_t dy,
+			       wl_fixed_t dx_unaccel, wl_fixed_t dy_unaccel)
+{
+	struct wayland_input *input = data;
+	struct weston_pointer_motion_event event = { 0 };
+	struct timespec ts;
+	double scale;
+
+	if (!input->capture.locked || !input->output || !input->has_focus)
+		return;
+
+	scale = input->output->base.current_scale;
+	if (scale < 1)
+		scale = 1;
+
+	timespec_from_usec(&ts, ((uint64_t) utime_hi << 32) | utime_lo);
+	event.mask = WESTON_POINTER_MOTION_REL |
+		     WESTON_POINTER_MOTION_REL_UNACCEL;
+	event.time = ts;
+	event.rel = weston_coord(wl_fixed_to_double(dx) / scale,
+				 wl_fixed_to_double(dy) / scale);
+	event.rel_unaccel = weston_coord(wl_fixed_to_double(dx_unaccel) / scale,
+					 wl_fixed_to_double(dy_unaccel) / scale);
+	input->capture.pos.c = weston_coord_add(input->capture.pos.c,
+						event.rel);
+	input->capture.pos =
+		weston_coord_global_clamp_for_output(input->capture.pos,
+						     &input->output->base);
+	notify_motion(&input->base, &ts, &event);
+
+	if (input->seat_version < WL_POINTER_FRAME_SINCE_VERSION)
+		notify_pointer_frame(&input->base);
+}
+
+static const struct zwp_relative_pointer_v1_listener relative_pointer_listener = {
+	relative_pointer_handle_motion,
+};
+
+/* Ctrl+Alt, pressed and let go with nothing else in between, is the
+ * release: what virtual machine viewers use, so it is the chord people
+ * already try. It is watched here rather than bound in the compositor,
+ * because the game has to go on seeing Ctrl and Alt for its own keys. */
+static void
+input_track_chord(struct wayland_input *input, bool ctrl, bool alt,
+		  bool others)
+{
+	if (others)
+		input->capture.spoiled = true;
+	if (ctrl && alt)
+		input->capture.chord = true;
+
+	if (!ctrl && !alt && !others) {
+		if (input->capture.chord && !input->capture.spoiled)
+			input_release_capture(input, true);
+		input->capture.chord = false;
+		input->capture.spoiled = false;
+	}
+	input->capture.ctrl = ctrl;
+	input->capture.alt = alt;
+}
